{
  "name": "camado",
  "version": "1.0.3",
  "description": "Камадо — личный ИИ-ассистент студента: Telegram-бот и приложение для компьютера",
  "scripts": {
    "dev": "tsx watch --env-file=.env --disable-warning=ExperimentalWarning src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.desktop.json",
    "test": "vitest run",
    "app": "electron-vite dev",
    "app:build": "electron-vite build",
    "app:start": "electron-vite preview",
    "app:dist": "electron-vite build && electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/killer-destroyer/camado.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/killer-destroyer/camado/issues"
  },
  "homepage": "https://github.com/killer-destroyer/camado",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@xhayper/discord-rpc": "^1.5.1",
    "electron-updater": "^6.8.11",
    "grammy": "^1.46.0",
    "katex": "^0.16.22",
    "music-metadata": "^12.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "main": "out/main/index.js",
  "author": "killer-destroyer"
}
