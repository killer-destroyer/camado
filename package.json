    "type": "git",
    "url": "git+https://github.com/killer-destroyer/camado-.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/killer-destroyer/camado-/issues"
  },
  "homepage": "https://github.com/killer-destroyer/camado-#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "grammy": "^1.46.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
