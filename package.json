{
  "name": "camado",
  "version": "0.1.0",
  "description": "Камадо — личный ИИ-ассистент студента в Telegram",
  "scripts": {
    "dev": "tsx watch --env-file=.env --disable-warning=ExperimentalWarning src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
