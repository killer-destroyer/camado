# Скопируй этот файл в .env и заполни.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Твой Telegram ID. Не знаешь? Запусти бота без него и напиши ему /id
OWNER_TELEGRAM_ID=

# Ключ Anthropic API (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Какие модели на какие задачи. Меняются здесь, код трогать не нужно.
#   fast  — дешёвые массовые задачи (разбор чатов)
#   brain — основной мозг: разговор, ДЗ, инструменты
#   smart — сложное: планы, разбор тем
CAMADO_MODEL_FAST=claude-haiku-5-5
CAMADO_MODEL_BRAIN=claude-sonnet-5-5
CAMADO_MODEL_SMART=claude-opus-5-5

# Лимит трат на API в месяц, в долларах. При достижении Камадо перестаёт звать модель.
CAMADO_MONTHLY_BUDGET_USD=25

# Твой часовой пояс (для дедлайнов и напоминаний)
CAMADO_TIMEZONE=America/New_York

# Где лежит база
CAMADO_DB_PATH=data/camado.db
